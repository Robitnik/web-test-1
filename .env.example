# Copy to .env and adjust. Every value is optional.

# Path to the Chrome binary. Empty = auto-detect (see src/webtest/chrome.py).
WEBTEST_CHROME_PATH=

# Browser profile (cookies, logins live here). One profile = one running browser.
WEBTEST_PROFILE_DIR=.profiles/default

# Headed is the stealth default. Headless is easier to detect.
WEBTEST_HEADLESS=0

# e.g. http://user:pass@host:port  (empty = direct connection)
WEBTEST_PROXY=

# Leave empty unless they match the proxy's geo: a mismatch is itself a signal.
WEBTEST_LOCALE=
WEBTEST_TIMEZONE=

WEBTEST_SLOW_MO_MS=0
WEBTEST_TIMEOUT_MS=30000
WEBTEST_DOWNLOADS_DIR=downloads
